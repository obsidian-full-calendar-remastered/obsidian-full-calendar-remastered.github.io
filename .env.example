# Paddle Billing environment: "sandbox" for testing, "production" for live go-live
VITE_PADDLE_ENV=sandbox

# Client-side token from Paddle Dashboard > Developer Tools > Authentication
# Sandbox tokens start with test_, live tokens start with live_
VITE_PADDLE_CLIENT_TOKEN=

# Recurring monthly Price IDs from Paddle Dashboard > Catalog > Products
VITE_PADDLE_PRICE_ID_PRO=
VITE_PADDLE_PRICE_ID_POWER=
